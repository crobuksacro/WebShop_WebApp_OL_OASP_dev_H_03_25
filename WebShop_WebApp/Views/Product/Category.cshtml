@model WebShop_Shared.Model.ViewModel.ProductCategoryViewModel


<h1>Kategorije</h1>

<div class="row">
    <div class="col-4">
        <dl class="row">
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.Id)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Id)
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.Name)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Name)
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.Description)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Description)
            </dd>
        </dl>
    </div>
    <div class="col-8">


        @Html.ActionLink("Dodaj novi proizvod", "CreateProduct", new { categoryId = Model.Id }, new { @class = "btn btn-primary mb-3" })

        <table class="table table-hover">
            <thead>
                <tr>
                    <th scope="col">#</th>
                    <th scope="col">Naziv</th>
                    <th scope="col">Opis</th>
                    <th scope="col">Cijena</th>
                    <th scope="col">Količina</th>
                    <th scope="col">Tip Količina</th>
                    <th scope="col">Uredi</th>
                </tr>
            </thead>
            <tbody>

                @foreach (var item in Model.Products)
                {
                    <tr>
                        <th scope="row">
                            @item.Id
                        </th>
                        <td>
                            @item.Name
                        </td>
                        <td>
                            @item.Description
                        </td>
                        <td>
                            @item.Price
                        </td>
                        <td>
                            @item.Quantity
                        </td>
                        <td>
                            @if (item.QuantityType != null)
                            {
                                @item.QuantityType.Name
                            }
                        </td>
                        <td>
                            @Html.ActionLink("Uredi", "EditProduct", new { id = item.Id })
                            @Html.ActionLink("Detalji", "DetailsProduct", new { id = item.Id })
                            @Html.ActionLink("Obrisi", "DeleteProduct", new { id = item.Id })
                        </td>
                    </tr>
                }


            </tbody>

        </table>
    </div>

</div>







<div>
    @Html.ActionLink("Uredi", "EditCategory", new { id = Model.Id }) |
    <a asp-action="Categorys">Back to List</a>
</div>
