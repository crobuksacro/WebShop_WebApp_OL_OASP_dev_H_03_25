@using WebShop_Shared.Model.ViewModel.ProductModels
@model ProductViewModel

@{
    ViewData["Title"] = "EditProduct";
}

<h1>@Model.Name</h1>

<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="EditProduct">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Id" class="control-label"></label>
                <input asp-for="Id" disabled class="form-control" />
                <span asp-validation-for="Id" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Description" class="control-label"></label>
                <input asp-for="Description" class="form-control" />
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Price" class="control-label"></label>
                <input asp-for="Price" class="form-control" />
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Quantity" class="control-label"></label>
                <input asp-for="Quantity" class="form-control" />
                <span asp-validation-for="Quantity" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="QuantityTypeId" class="control-label"></label>
                @*                 <select asp-for="QuantityTypeId" class="form-control" asp-items="@(new SelectList(Model.QuantityTypes, "Id", "Name"))">
                    <option value="">Odaberi Mjernu jedinicu</option>
                </select> *@

                <select name="QuantityTypeId" class="form-select">

                    <optgroup label="Mjerne jedinice">
                        @if (Model.QuantityTypes != null)
                        {
                            foreach (var type in Model.QuantityTypes)
                            {
                                <option value="@type.Id">@type.Name</option>
                            }
                        }
                    </optgroup>
                </select>

                <span asp-validation-for="QuantityTypeId" class="text-danger"></span>
            </div>

            <div class="form-group">
                @Html.ActionLink("Nazad", "Category", new { Id = Model.ProductCategoryId }, new { @class = "btn btn-primary" })
                <input type="submit" value="Pošalji" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>

    
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
