@model WebShop_Shared.Model.ViewModel.OrderModels.OrderViewModel

@{
    ViewData["Title"] = "OrderDetails";
    int rowCounter = 1;
    var statusLabels = Model.GetStatusLabels();
    var translatedStatus = statusLabels.FirstOrDefault(y => y.Key == Model.OrderStatus); // Fixed the variable name from trnslatedStatus to translatedStatus


}

<h4>Narudžba broj @Model.Id</h4>

<div class="row">
    <div class="col-md-4 mb-5">
        <span><b>@Html.DisplayNameFor(model => model.Id):</b>      @Html.DisplayFor(model => model.Id)</span><br />
        <span><b>@Html.DisplayNameFor(model => model.Created):</b>      @Html.DisplayFor(model => model.Created)</span><br />
        <span><b>@Html.DisplayNameFor(model => model.OrderStatus):</b>      @translatedStatus.Value</span><br />
        <span><b>@Html.DisplayNameFor(model => model.Total):</b>      @Html.DisplayFor(model => model.Total)</span><br />
        <span><b>@Html.DisplayNameFor(model => model.Message):</b>      @Html.DisplayFor(model => model.Message)</span><br />


        <h3>Adresa isporuke</h3>
        <span><b>@Html.DisplayNameFor(model => model.OrderAddress.Country):</b>      @Html.DisplayFor(model => model.OrderAddress.Country)</span><br />
        <span><b>@Html.DisplayNameFor(model => model.OrderAddress.City):</b>      @Html.DisplayFor(model => model.OrderAddress.City)</span><br />
        <span><b>@Html.DisplayNameFor(model => model.OrderAddress.Street):</b>      @Html.DisplayFor(model => model.OrderAddress.Street)</span><br />
        <span><b>@Html.DisplayNameFor(model => model.OrderAddress.Number):</b>      @Html.DisplayFor(model => model.OrderAddress.Number)</span><br />

    </div>

    <div class="col-md-8">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Naziv Kategorije</th>
                    <th>Naziv</th>
                    <th>Količina</th>
                    <th>Cijena</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var prductItem in Model.OrderItems)
                {
                    <tr>
                        <td>@rowCounter</td>

                        <td>@prductItem.Product.ProductCategory.Name</td>
                        <td>@prductItem.Product.Name</td>
                        <td>
                            @prductItem.Quantity
                        </td>
                        <td>
                            @prductItem.Price
                        </td>

                    </tr>

                    rowCounter++;
                }
            </tbody>

        </table>
    </div>
</div>
<div>
    @Html.ActionLink("Storniraj", "CanceleOrder", new { id = Model.Id }, new { @class = "btn btn-danger" })
    @Html.ActionLink("Nazad", "Orders", null, null, new { @class = "btn btn-primary" })
</div>
