@model WebShop_Shared.Model.ViewModel.OrderModels.OrderViewModel

@{
    ViewData["Title"] = "OrderDetails";
    int rowCounter = 1;
}

<h4>Narudžba broj @Model.Id</h4>

<div class="row">
    <div class="col-md-4">
        <dl class="row">
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.Id)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Id)
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.Created)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Created)
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.OrderStatus)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.OrderStatus)
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.Total)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Total)
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.Message)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Message)
            </dd>

        </dl>
    </div>

    <div class="col-md-8">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Naziv Kategorije</th>
                    <th>Naziv</th>
                    <th>Količina</th>
                    <th>Cijena</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var prductItem in Model.OrderItems)
                {
                    <tr>
                        <td>@rowCounter</td>

                        <td>@prductItem.Product.ProductCategory.Name</td>
                        <td>@prductItem.Product.Name</td>
                        <td>
                            @prductItem.Quantity
                        </td>
                        <td>
                            @prductItem.Price
                        </td>

                    </tr>

                    rowCounter++;
                }
            </tbody>

        </table>
    </div>
</div>
<div>
    @Html.ActionLink("Storniraj", "CanceleOrder", new { id = Model.Id }, new { @class = "btn btn-danger" })
    @Html.ActionLink("Nazad", "Orders", null, null, new { @class = "btn btn-primary" })
</div>
