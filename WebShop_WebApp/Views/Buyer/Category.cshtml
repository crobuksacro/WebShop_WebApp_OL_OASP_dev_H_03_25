@using WebShop_Shared.Model.ViewModel.ProductModels
@model ProductCategoryViewModel


<h1>Kategorije</h1>

<div class="row">
    <div class="col-4">
        <dl class="row">
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.Id)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Id)
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.Name)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Name)
            </dd>
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.Description)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Description)
            </dd>
        </dl>
    </div>
    <div class="col-8">

        <table class="table table-hover">
            <thead>
                <tr>
                    <th scope="col">#</th>
                    <th scope="col">Naziv</th>
                    <th scope="col">Opis</th>
                    <th scope="col">Cijena</th>
                    <th scope="col">Količina</th>
                    <th scope="col">Tip Količina</th>
                    <th scope="col">Odaberi</th>
                </tr>
            </thead>
            <tbody>

                @foreach (var item in Model.Products)
                {
                    <tr>
                        <th scope="row">
                            @item.Id
                        </th>
                        <td>
                            @item.Name
                        </td>
                        <td>
                            @item.Description
                        </td>
                        <td>
                            @item.Price
                        </td>
                        <td>
                            @item.Quantity
                        </td>
                        <td>
                            @if (item.QuantityType != null)
                            {
                                @item.QuantityType.Name
                            }
                        </td>
                        <td>
                            <input type="button"
                                   class="btn btn-primary"
                                   value="Odaberi"
                                   onclick="AddItemToShoppingChart(this)"
                                   att-id="@item.Id"
                                   att-product-name="@item.Name"
                                   att-product-description="@item.Description"
                                   att-product-price="@item.Price"
                                   att-product-quantity="@item.Quantity" />
                        </td>
                    </tr>
                }


            </tbody>

        </table>
    </div>

</div>



<div class="modal fade" id="order-modal" tabindex="-1" role="dialog" aria-labelledby="orderModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">

            <div class="modal-body">
                <form>
                    <div class="form-group">
                        <label for="product-name" class="col-form-label">Naziv:</label>
                        <input type="text" class="form-control" id="product-name" readonly>
                    </div>
                    <div class="form-group">
                        <label for="product-description" class="col-form-label">Opis:</label>
                        <textarea class="form-control" id="product-description" readonly></textarea>
                    </div>
                    <div class="form-group">
                        <label for="product-price" class="col-form-label">Cijena:</label>
                        <input type="text" class="form-control" id="product-price" readonly>
                    </div>
                    <div class="form-group">
                        <label for="product-quantity" class="col-form-label">Dostupna Količina:</label>
                        <input type="text" class="form-control" id="product-quantity" readonly>
                    </div>
                    <div class="form-group">
                        <label for="order-quantity" class="col-form-label">Količina za narudžbu:</label>
                        <input type="number" class="form-control" id="ordered-quantity" value="1" required min="1">
                    </div>


                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" onclick="CloseModal()" data-dismiss="modal">Zatvori</button>
                <button type="button" class="btn btn-primary" onclick="ConfirmOrder()">Potvrdi</button>
            </div>
        </div>
    </div>
</div>






<div>
    <a asp-action="Index">Back to List</a>
</div>



<script>
    let currentButton; //Podaci koji su dosli sa odabirom gumba "Odaberi" na listi proizvoda
    const orderItems = {}; //Objekt za pohranu proizvoda

    var test = 0;


    //Prikazi odabrani prouzvod
    function AddItemToShoppingChart(e){
        currentButton = e;

        //Dohvati iz gumba sve podatke o proizvodu
        var productName = e.getAttribute('att-product-name');
        var productDescription = e.getAttribute('att-product-description');
        var productPrice = e.getAttribute('att-product-price');
        var productQuantity = e.getAttribute('att-product-quantity');

        //Prikaži sve stavke proizvoda
        document.getElementById('product-name').value = productName;
        document.getElementById('product-description').value = productDescription;
        document.getElementById('product-price').value = productPrice;
        document.getElementById('product-quantity').value = productQuantity;

        $('#order-modal').modal('show');

    }

    function CloseModal(){
         $('#order-modal').modal('hide');
    }


    function ConfirmOrder()
    {
                                //$('#ordered-quantity')
        var orderQuantity = parseInt(document.getElementById('ordered-quantity').value);
        var productQuantity = parseInt(document.getElementById("product-quantity").value);
        var productId = currentButton.getAttribute("att-id");


        if(orderQuantity > productQuantity)
        {
          document.getElementById('ordered-quantity').classList.add('is-invalid');
          return;
        }

        else{
            document.getElementById('ordered-quantity').classList.remove('is-invalid');
            if(currentButton){
                currentButton.className = 'btn btn-success';
                currentButton.value = 'Odabrano: '+orderQuantity;

            }


            orderItems[productId] = orderQuantity;
            CloseModal();

        }


        // alert("Narucena kolicina: " + orderQuantity + ", za proizvod"+productId);

    }

</script>